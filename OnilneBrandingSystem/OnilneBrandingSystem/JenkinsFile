pipeline {
    agent any

    environment {
        GIT_URL       = "https://github.com/kallepallinaveen/ONLINE-BRANDING-SYSTEM-PP-.git"
        BRANCH        = "master"

        SOLUTION_FILE = "OnilneBrandingSystem/OnilneBrandingSystem.sln"
        PROJECT_FILE  = "OnilneBrandingSystem\\OnilneBrandingSystem\\OnilneBrandingSystem.csproj"

        BUILD_CONFIG  = "Release"

        MSBUILD_PATH  = "C:\\Program Files\\Microsoft Visual Studio\\18\\Enterprise\\MSBuild\\Current\\Bin\\MSBuild.exe"
        NUGET_PATH    = "C:\\Program Files\\NuGet\\nuget.exe"

        PUBLISH_DIR   = "C:\\Jenkins\\OnlineBranding_Publish"
        MSI_OUTPUT    = "C:\\Jenkins\\OnlineBrandingSystem.msi"

        WIX_BIN       = "C:\\Program Files (x86)\\WiX Toolset v3.14\\bin"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: "${BRANCH}", url: "${GIT_URL}"
            }
        }

        stage('Restore NuGet Packages') {
            steps {
                bat "\"%NUGET_PATH%\" restore \"%SOLUTION_FILE%\""
            }
        }

        stage('Build Solution') {
            steps {
                bat """
                "%MSBUILD_PATH%" "%SOLUTION_FILE%" ^
                /p:Configuration=%BUILD_CONFIG% ^
                /t:Build
                """
            }
        }

        stage('Publish Project') {
            steps {
                bat """
                if not exist "%PUBLISH_DIR%" mkdir "%PUBLISH_DIR%"

                "%MSBUILD_PATH%" "%PROJECT_FILE%" ^
                /p:Configuration=%BUILD_CONFIG% ^
                /p:DeployOnBuild=true ^
                /p:WebPublishMethod=FileSystem ^
                /p:PublishUrl=%PUBLISH_DIR% ^
                /p:DeleteExistingFiles=true
                """
            }
        }

        stage('Create MSI Installer') {
    steps {
        bat """
        "%WIX_BIN%\\candle.exe" ^
        OnilneBrandingSystem\\OnilneBrandingSystem\\Installer\\Product.wxs ^
        -dPublishDir="%PUBLISH_DIR%" ^
        -out OnilneBrandingSystem\\OnilneBrandingSystem\\Installer\\Product.wixobj

        "%WIX_BIN%\\light.exe" ^
        OnilneBrandingSystem\\OnilneBrandingSystem\\Installer\\Product.wixobj ^
        -out "%MSI_OUTPUT%"
                    """
                }
            }


        stage('Install MSI') {
            steps {
                bat """
                msiexec /i "%MSI_OUTPUT%" /quiet /norestart
                """
            }
        }
    }

    post {
        success {
            echo "✅ Build, MSI creation, and installation completed successfully"
        }
        failure {
            echo "❌ Pipeline failed"
        }
    }
}
