pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        buildDiscarder(logRotator(numToKeepStr: '5'))
    }

    environment {
        GIT_URL       = "https://github.com/kallepallinaveen/ONLINE-BRANDING-SYSTEM-PP-.git"
        BRANCH        = "master"

        SOLUTION_FILE = "OnilneBrandingSystem/OnilneBrandingSystem.sln"
        PROJECT_FILE  = "OnilneBrandingSystem\\OnilneBrandingSystem\\OnilneBrandingSystem.csproj"

        BUILD_CONFIG  = "Release"

        MSBUILD_PATH  = "C:\\Program Files\\Microsoft Visual Studio\\18\\Enterprise\\MSBuild\\Current\\Bin\\MSBuild.exe"
        NUGET_PATH    = "C:\\Program Files\\NuGet\\nuget.exe"

        PUBLISH_DIR   = "C:\\Jenkins\\OnlineBranding_Publish"
        MSI_OUTPUT    = "C:\\Jenkins\\OnlineBrandingSystem_${BUILD_NUMBER}.msi"

        WIX_BIN       = "C:\\Program Files (x86)\\WiX Toolset v3.14\\bin"

        SITE_NAME     = "OnlineBrandingSite"
        APP_POOL      = "OnlineBrandingAppPool"
        SITE_PORT     = "8089"
    }

    stages {

        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Checkout Code') {
            steps {
                git branch: "${BRANCH}", url: "${GIT_URL}"
            }
        }

        stage('Restore NuGet Packages') {
            steps {
                bat "\"%NUGET_PATH%\" restore \"%SOLUTION_FILE%\""
            }
        }

        stage('Build Solution') {
            steps {
                bat """
                "%MSBUILD_PATH%" "%SOLUTION_FILE%" ^
                /p:Configuration=%BUILD_CONFIG% ^
                /t:Rebuild
                """
            }
        }

        stage('Publish Project') {
            steps {
                bat """
                if exist "%PUBLISH_DIR%" rmdir /s /q "%PUBLISH_DIR%"
                mkdir "%PUBLISH_DIR%"

                "%MSBUILD_PATH%" "%PROJECT_FILE%" ^
                /p:Configuration=%BUILD_CONFIG% ^
                /p:OutDir=%PUBLISH_DIR%\\ ^
                /t:Rebuild
                """

                bat "dir \"%PUBLISH_DIR%\" /s"
            }
        }

        stage('Clean Old MSI Files') {
            steps {
                powershell '''
                $msiPath = "C:\\Jenkins"
                Get-ChildItem $msiPath -Filter "*.msi" -ErrorAction SilentlyContinue | Remove-Item -Force
                Write-Host "Old MSI files removed"
                '''
            }
        }

        stage('Create MSI Installer') {
            steps {
                bat """
                "%WIX_BIN%\\heat.exe" dir "%PUBLISH_DIR%" ^
                -cg AppFiles ^
                -dr INSTALLFOLDER ^
                -srd ^
                -gg ^
                -out OnilneBrandingSystem\\OnilneBrandingSystem\\Installer\\Files.wxs

                "%WIX_BIN%\\candle.exe" ^
                OnilneBrandingSystem\\OnilneBrandingSystem\\Installer\\Product.wxs ^
                OnilneBrandingSystem\\OnilneBrandingSystem\\Installer\\Files.wxs ^
                -out OnilneBrandingSystem\\OnilneBrandingSystem\\Installer\\

                "%WIX_BIN%\\light.exe" ^
                OnilneBrandingSystem\\OnilneBrandingSystem\\Installer\\Product.wixobj ^
                OnilneBrandingSystem\\OnilneBrandingSystem\\Installer\\Files.wixobj ^
                -b "%PUBLISH_DIR%" ^
                -out "%MSI_OUTPUT%"
                """
            }
        }

        stage('Install MSI') {
            steps {
                bat "msiexec /i \"%MSI_OUTPUT%\" /quiet /norestart"
            }
        }

        stage('Configure IIS Site') {
            steps {
                powershell '''
                Import-Module WebAdministration

                $siteName = "OnlineBrandingSite"
                $appPool = "OnlineBrandingAppPool"
                $physicalPath = "C:\\Jenkins\\OnlineBranding_Publish"
                $port = 8089

                Write-Host "Checking App Pool..."

                if (!(Test-Path IIS:\\AppPools\\$appPool)) {
                    New-WebAppPool -Name $appPool
                    Write-Host "App Pool Created"
                }
                else {
                    Write-Host "App Pool Already Exists"
                }

                Write-Host "Checking Website..."

                if (!(Test-Path IIS:\\Sites\\$siteName)) {
                    New-Website -Name $siteName `
                                -Port $port `
                                -PhysicalPath $physicalPath `
                                -ApplicationPool $appPool
                    Write-Host "Website Created"
                }
                else {
                    Write-Host "Website Already Exists"
                }

                Start-Website -Name $siteName

                Write-Host "IIS Configuration Completed Successfully"
                '''
            }
        }

    }

    post {
        success {
            echo "✅ Full CI/CD Pipeline Executed Successfully"
            echo "🌐 Access your application at: http://localhost:${SITE_PORT}"
        }
        failure {
            echo "❌ Pipeline Failed"
        }
    }
}
