stage('Create MSI Installer') {
    steps {
        bat """
        "%WIX_BIN%\\heat.exe" dir "%PUBLISH_DIR%" ^
        -cg AppFiles ^
        -dr INSTALLFOLDER ^
        -srd ^
        -gg ^
        -out OnilneBrandingSystem\\OnilneBrandingSystem\\Installer\\Files.wxs

        "%WIX_BIN%\\candle.exe" ^
        OnilneBrandingSystem\\OnilneBrandingSystem\\Installer\\Product.wxs ^
        OnilneBrandingSystem\\OnilneBrandingSystem\\Installer\\Files.wxs ^
        -out OnilneBrandingSystem\\OnilneBrandingSystem\\Installer\\

        "%WIX_BIN%\\light.exe" ^
        OnilneBrandingSystem\\OnilneBrandingSystem\\Installer\\Product.wixobj ^
        OnilneBrandingSystem\\OnilneBrandingSystem\\Installer\\Files.wixobj ^
        -out "%MSI_OUTPUT%"
        """

        script {
            if (!fileExists(env.MSI_OUTPUT)) {
                error "MSI file was not created!"
            }
        }
    }
}
